// ====================================================================
// DIAGNÓSTICO: esta variable te dice hasta dónde llegó el código
//   1 = entró a LCD_Raw_Test
//   2 = hizo el RESET físico del display
//   3 = mandó Software Reset por SPI  <- si se queda aquí, SPI no funciona
//   4 = mandó Sleep Out
//   5 = mandó Display ON + pixel format
//   6 = terminó de pintar la pantalla  <- si llega aquí y no ves rojo, problema de display
// ====================================================================
volatile uint32_t debug_status = 0;
volatile HAL_StatusTypeDef spi_last_result = HAL_OK;

static void spi_cmd(uint8_t cmd) {
    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_3, GPIO_PIN_RESET); // DC = 0
    spi_last_result = HAL_SPI_Transmit(&hspi1, &cmd, 1, 500);
}
static void spi_data(uint8_t data) {
    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_3, GPIO_PIN_SET);   // DC = 1
    spi_last_result = HAL_SPI_Transmit(&hspi1, &data, 1, 500);
}
static void LCD_Raw_Test(void) {
    debug_status = 1; // Entró a la función

    // CS = LOW
    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, GPIO_PIN_RESET);

    // RESET físico
    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_2, GPIO_PIN_RESET);
    HAL_Delay(100);
    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_2, GPIO_PIN_SET);
    HAL_Delay(100);
    debug_status = 2; // RESET físico hecho

    spi_cmd(0x01); HAL_Delay(150); // Software Reset
    debug_status = 3; // Software Reset enviado

    spi_cmd(0x11); HAL_Delay(150); // Sleep Out
    debug_status = 4; // Sleep Out enviado

    spi_cmd(0x29); HAL_Delay(50);  // Display ON
    spi_cmd(0x3A); spi_data(0x55); // Pixel Format 16-bit
    spi_cmd(0x36); spi_data(0xE8); // MADCTL landscape
    spi_cmd(0x2A);                 // Column address
    spi_data(0x00); spi_data(0x00); spi_data(0x01); spi_data(0x3F);
    spi_cmd(0x2B);                 // Row address
    spi_data(0x00); spi_data(0x00); spi_data(0x00); spi_data(0xEF);
    debug_status = 5; // Configuración enviada, a punto de pintar

    spi_cmd(0x2C); // Write Memory Start
    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_3, GPIO_PIN_SET); // DC = 1
    static uint8_t linea[320 * 2];
    for (int x = 0; x < 320; x++) {
        linea[x * 2]     = 0xF8;
        linea[x * 2 + 1] = 0x00;
    }
    for (int y = 0; y < 240; y++) {
        spi_last_result = HAL_SPI_Transmit(&hspi1, linea, sizeof(linea), 1000);
    }
    debug_status = 6; // Terminó de pintar
}

